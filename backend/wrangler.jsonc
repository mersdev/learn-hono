{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petitbakery-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://petitbakery.pages.dev",
    "CORS_ORIGIN": "https://petitbakery.pages.dev",
    "BETTER_AUTH_URL": "https://petitbakery-api.velozz.workers.dev/api/auth",
    "EMAIL_FROM": "PetitBakery <onboarding@resend.dev>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petitbakery-db",
      "database_id": "5f96f9c6-4309-4412-9dbd-05662419517f"
    }
  ]
}
